<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="480.0"
            stylesheets="@lizzy.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lizzy.gui.MainWindow">
    <top>
        <Label maxWidth="Infinity" text="Lizzy" styleClass="title">
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>
        </Label>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0" styleClass="dialog-container">
                    <padding>
                        <Insets bottom="18.0" left="16.0" right="16.0" top="18.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10.0" styleClass="composer">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
            <TextField fx:id="userInput" accessibleText="Command input"
                       onAction="#handleUserInput" promptText="Enter a command…"
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" defaultButton="true"
                    onAction="#handleUserInput" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
